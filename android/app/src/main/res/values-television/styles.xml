<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android TV: the launch window uses the splash stage colour, so the
         first Flutter frame (an empty #05080B stage) follows without a flash.
         The UI-mode qualifier outranks values-night, so TV is always dark. -->
    <color name="tv_splash_background">#FF05080B</color>

    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/tv_splash_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/tv_splash_background</item>
    </style>
</resources>
